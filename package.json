{
  "name": "opencode-jobs",
  "version": "0.5.0",
  "description": "Persistent node-local background jobs, monitors, schedules and loops for OpenCode V2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/daniilpet/opencode-jobs.git"
  },
  "bugs": {
    "url": "https://github.com/daniilpet/opencode-jobs/issues"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "test": "node --expose-gc --test",
    "test:tui": "bun test --preload @opentui/solid/preload ./test-tui/",
    "audit:dependencies": "npm audit --package-lock-only --include=dev --include=optional --include=peer --audit-level=info",
    "check": "node scripts/check.js",
    "check:security-dependencies": "node scripts/check-security-dependencies.js",
    "check:bridge-lifetime": "node --expose-gc --test --test-name-pattern=\"10s timeout API|timeout discovery|ошибка отмены тела\" test/bridge.test.js",
    "build": "node scripts/build.js",
    "package": "node scripts/package-release.js"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.32",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@babel/core": "^7.28.0",
    "babel-preset-solid": "1.9.12",
    "solid-js": "1.9.12"
  },
  "overrides": {
    "seroval": "^1.8.0",
    "@opentui/solid@0.5.17": {
      "@babel/core": "^7.29.7"
    },
    "@npmcli/arborist": "10.0.4",
    "@npmcli/config": "11.2.0",
    "@npmcli/map-workspaces": "6.0.0",
    "@npmcli/metavuln-calculator": "10.0.0",
    "@npmcli/package-json": "8.0.0",
    "@npmcli/run-script": "11.0.0",
    "pacote": "22.0.1",
    "cacache": "21.0.1",
    "minimatch": "11.0.5",
    "npm-registry-fetch": "20.0.1",
    "glob": "14.0.4",
    "sigstore": "5.0.1",
    "@sigstore/sign": "5.1.0",
    "@sigstore/tuf": "5.0.1",
    "@tufjs/models": "5.0.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
